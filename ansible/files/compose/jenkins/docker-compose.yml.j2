services:
  jenkins:
    build:
      context: .
      dockerfile: Dockerfile
    image: jenkins-local-image
    container_name: jenkins
    restart: unless-stopped
    networks:
      - main_network
    ports:
      - "6500:8080"
    volumes:
      - jenkins_data:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
    group_add:
      - "{{ docker_gid }}"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: "1g"

volumes:
  jenkins_data:

networks:
  main_network:
    external: true
